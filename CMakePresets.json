{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc",
      "displayName": "GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "/opt/toolchain/gcc.cmake",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "MSLAM_INTEGRATION_TESTS": "ON",
        "MSLAM_INSTALL_REPLAY_SERVER": "ON",
        "MSLAM_INSTALL_REMOTE_RECORDER": "ON",
        "MSLAM_WITH_TBB": "ON"
      }
    },
    {
      "name": "pi5",
      "displayName": "Raspberry Pi 5 (Cortex-A76)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc-16",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-16",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "MSLAM_CPU": "cortex-a76",
        "MSLAM_WITH_TBB": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-gcc",
      "configurePreset": "gcc",
      "verbose": false
    },
    {
      "name": "build-pi5",
      "configurePreset": "pi5",
      "verbose": false
    }
  ],
  "testPresets": [
    {
      "name": "gcc",
      "displayName": "Unit tests (integration excluded)",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "integration" } }
    },
    {
      "name": "gcc-integration",
      "displayName": "Integration tests only",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "integration" } }
    },
    {
      "name": "gcc-all",
      "displayName": "All tests",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true }
    }
  ]
}
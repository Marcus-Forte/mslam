{
    "imu": true,
    "lidar" : true,
    "camera": false,
    "imu_acceleration_scale": 9.80665,
    "log_level": "info", // trace || debug || info || warning || error
    "map_type": "voxel",
    "remote_scanner": "localhost:50051", // "local" for on-board Mid360, or host:port of a sensor/replay server

    "preprocessor": {
        "voxel_size": 0.05,
        "min_distance_to_center": 1.0,
        "min_intensity": 5,
        "downsample_filter": "voxel_hash", // voxel_hash
        "deskew": true, // on/off: deskew scans using a constant-velocity twist
        "points_per_second": 200000 // 0 to disable time-aware deskew
    },
    "map": {
        "resolution": 0.1,
        "max_points_per_voxel": 2,
        // Voxels searched around a query (optional, default 1 = 3x3x3, max 8).
        // Neighbours are only guaranteed within search_radius * resolution;
        // a larger slam.max_correspondence_distance may miss matches or find
        // a non-nearest one (Slam logs a warning at startup).
        "search_radius": 1,
        // Bound the registration map so per-scan cost stays flat over long runs.
        "max_voxels": 0, // 0 disables the voxel budget
        "max_range": 0, // 0 disables radius pruning (m)
        "dense_map": false // unused 1 cm map: leave off (memory)
    },

    "slam": {
        "optimizer_iterations": 5,
        "reg_iterations": 5,
        "max_correspondence_distance": 0.1,
        // How the IMU is used when "imu" is on (optional):
        //   "preintegration_factor": IMU residual in the joint optimization (default)
        //   "dead_reckoning": IMU only integrated forward, seeds pose-only scan matching
        "imu_fusion": "preintegration_factor",
        // Estimator (optional, default "odometry" = LiDAR-inertial odometry only):
        //   "odometry": the odometry alone
        //   "N": the same odometry plus keyframes, loop closure and a
        //                 pose-graph back end (see "pose_graph" below)
        "strategy": "pose_graph"
    }

    // SYCL is the only parallel path (optional block; absent = disabled).
    , "sycl": {
        "enabled": false, // true: registration and preprocessing run as SYCL kernels (needs a build with MSLAM_WITH_SYCL); false (default): the sequential host code
        "threads": 0      // work-groups of mslam's SYCL kernels (correspondence search, preprocessing); 0 (default) = every compute unit; the pose does not depend on it
    }

    // Pose-graph back end, read only when "strategy" is "pose_graph"; every key
    // is optional (defaults shown).
    // , "pose_graph": {
    //     "keyframe_distance": 0.5,            // m moved before a new keyframe
    //     "keyframe_angle": 0.26,              // rad turned before a new keyframe
    //     "keyframe_max_interval_s": 0,        // s; closes a keyframe while still, 0 = off
    //     "mini_map_voxel_size": 0.05,         // m, thinning of a keyframe's mini map
    //     "loop_search_radius": 2.0,           // m, loop candidates around a keyframe
    //     "loop_min_separation": 10,           // keyframes skipped as recent neighbours
    //     "loop_submap_keyframes": 2,          // neighbours each side forming the target
    //     "loop_max_rms": 0.05,                // m, verification gate
    //     "loop_min_matched_fraction": 0.6,    // (0, 1], verification gate
    //     "loop_sigma_translation": 0.02,      // m
    //     "loop_sigma_rotation": 0.005,        // rad
    //     "odometry_sigma_translation": 0.05,  // m
    //     "odometry_sigma_rotation": 0.01,     // rad
    //     "optimizer_iterations": 20,
    //     "synchronous": false                 // true: back end inline (deterministic replays)
    // }
}